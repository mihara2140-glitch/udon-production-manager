# 公開先の設定画面で値を設定する。実際の秘密情報はGitHubへ上げない。
APP_PASSWORD=change-this-password
FLASK_SECRET_KEY=change-this-to-a-long-random-secret
COOKIE_SECURE=1

# AI粉検索。実際のAPIキーはGitHubへ上げず、ローカルの.envまたは公開先の環境変数に設定する。
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

# SQLiteを永続ストレージへ置く場合に指定する。
# 例: /home/yourname/udon-production-manager/data/udon_manager.db
UDON_DB_PATH=/path/to/persistent/udon_manager.db
